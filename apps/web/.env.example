DATABASE_URL=postgres://user@localhost:5432/typemaster_dev
# generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Optional Google sign-in:
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Password reset emails. In development leave these unset: the reset link is printed in the server log.
# Production needs SITE_URL (no trailing slash) plus an email provider:
SITE_URL=
RESEND_API_KEY=
EMAIL_FROM=
